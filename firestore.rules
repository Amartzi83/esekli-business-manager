rules_version = '2';

// Everything is closed unless a rule below opens it. Business data is available only to
// that business's members, and a user can join only with a valid, unused invite link.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
    }

    match /workspaces/{workspaceId} {
      function workspacePath() {
        return /databases/$(database)/documents/workspaces/$(workspaceId);
      }
      function isMember() {
        return signedIn() && me() in get(workspacePath()).data.memberIds;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function membersChangedOnlyForMe() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()]);
      }
      function validInvite(token) {
        let path = /databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(token);
        let invite = get(path).data;
        return invite.usedBy == null
          && invite.expiresAt > request.time
          && getAfter(path).data.usedBy == me();
      }

      allow get: if signedIn() && me() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'createdAt'])
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow update: if signedIn() && (
        // The owner renames the business or removes members, and always stays in it.
        (
          resource.data.ownerId == me()
          && changedKeys().hasOnly(['name', 'memberIds', 'members'])
          && me() in request.resource.data.memberIds
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
        )
        // A new user adds only themselves, with a valid invite that this same write uses up.
        || (
          !(me() in resource.data.memberIds)
          && changedKeys().hasOnly(['memberIds', 'members', 'joinToken'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && me() in request.resource.data.memberIds
          && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
          && membersChangedOnlyForMe()
          && request.resource.data.members[me()].role == 'member'
          && validInvite(request.resource.data.joinToken)
        )
        // A member other than the owner removes only themselves.
        || (
          me() in resource.data.memberIds
          && resource.data.ownerId != me()
          && changedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !(me() in request.resource.data.memberIds)
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && membersChangedOnlyForMe()
        )
      );

      match /items/{itemId} {
        allow read, delete: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['c', 'id', 'data', 'updatedAt', 'updatedBy', 'client'])
          && request.resource.data.c is string
          && request.resource.data.id is string
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000
          && request.resource.data.updatedBy == me();
      }

      match /photos/{photoId} {
        allow read, delete: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['id', 'visitId', 'data', 'createdAt', 'updatedBy', 'client'])
          && request.resource.data.id is string
          && request.resource.data.visitId is string
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000
          && request.resource.data.updatedBy == me();
      }

      match /invites/{token} {
        // Reading needs the secret token from the link. Only members can list invites.
        allow get: if signedIn();
        allow list: if isMember();
        allow delete: if signedIn() && get(workspacePath()).data.ownerId == me();
        allow create: if signedIn()
          && get(workspacePath()).data.ownerId == me()
          && token.size() >= 40
          && request.resource.data.keys().hasOnly(['workspaceName', 'createdBy', 'createdByName', 'expiresAt', 'usedBy', 'usedAt', 'createdAt'])
          && request.resource.data.createdBy == me()
          && request.resource.data.usedBy == null
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
        allow update: if signedIn()
          && resource.data.usedBy == null
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == me()
          && me() in getAfter(workspacePath()).data.memberIds;
      }
    }
  }
}
